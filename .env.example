# 复制本文件为 .env 并填入真实值。
# .env 已在 .gitignore 中，不会被提交到仓库。

# 被测服务地址（结尾带不带 / 都可以）
SEAFILE_BASE_URL=http://your-seafile-host:8000/

# 管理员账号
SEAFILE_ADMIN_EMAIL=admin@example.com
SEAFILE_ADMIN_PASSWORD=your-admin-password

# 普通成员账号（用于验证越权访问应被拒绝）
SEAFILE_MEMBER_EMAIL=member@example.com
SEAFILE_MEMBER_PASSWORD=your-member-password

# 以下为可选项，不填则使用默认值
# SEAFILE_TEST_PASSWORD=user
# SEAFILE_REPO_PASSWORD=abC123456
# SEAFILE_TIMEOUT=10
